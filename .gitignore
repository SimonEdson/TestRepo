# EXE folder at repo root: keep folder + readme.txt, ignore compiled outputs
[Ee][Xx][Ee]/*
![Ee][Xx][Ee]/readme.txt

# Debug folder at repo root (VB6 monorepo): keep folder + Readme.txt, ignore executables
/[Dd]ebug/*
!/[Dd]ebug/[Rr]eadme.txt

# VB6 ForeignLanguage/Debug: keep folder + Readme.txt, ignore executables (same as root Debug)
/[Ff]oreign[Ll]anguage/[Dd]ebug/*
!/[Ff]oreign[Ll]anguage/[Dd]ebug/[Rr]eadme.txt

# VB.NET ForeignLanguage/EXE: keep folder + Readme.txt, ignore executables (same as root EXE)
/[Ff]oreign[Ll]anguage/[Ee][Xx][Ee]/*
!/[Ff]oreign[Ll]anguage/[Ee][Xx][Ee]/[Rr]eadme.txt

